{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-0111"
		},
		"LS_ADLS_SINK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adls0111.dfs.core.windows.net/"
		},
		"LS_AKV_SQLDB_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://realmofisha-keyvault.vault.azure.net/"
		},
		"LS_AZURE_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "demosqlsrv00111.database.windows.net"
		},
		"LS_AZURE_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demosqldb"
		},
		"LS_AZURE_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "realmofisha"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-0111_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_SINK_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_SINK_properties_typeProperties_url')]"
					},
					"LS_AKV_SQLDB_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AKV_SQLDB_properties_typeProperties_baseUrl')]"
					},
					"LS_AZURE_SQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AZURE_SQL_properties_typeProperties_server')]"
					},
					"LS_AZURE_SQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AZURE_SQL_properties_typeProperties_database')]"
					},
					"LS_AZURE_SQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AZURE_SQL_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}