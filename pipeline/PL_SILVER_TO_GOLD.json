{
	"name": "PL_SILVER_TO_GOLD",
	"properties": {
		"activities": [
			{
				"name": "READ_LIST_SRC_TABLES",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select table_id,gold_table_name from ctrl.table_config where is_active=1 and stage = 'SILVER_TO_GOLD'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AZURE_SQL_SOURCE",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Ingest_all_tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "READ_LIST_SRC_TABLES",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('READ_LIST_SRC_TABLES').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "INSERT_INPROGRESS_STATUS",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AZURE_SQL_METADATA",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "insert into ctrl.audit_log(adf_run_id,table_id,stage,status,start_time)\nVALUES('@{pipeline().parameters.adf_run_id}',@{item().table_id},'SILVER_TO_GOLD','IN_PROGRESS',SYSUTCDATETIME());",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "UPDATE_FAILED_STATUS",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "SILVER_TO_GOLD",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AZURE_SQL_METADATA",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.audit_log set status='FAILED', end_time=SYSUTCDATETIME() where adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{item().table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "SILVER_TO_GOLD",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "INSERT_INPROGRESS_STATUS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "/caresync-repo/caresync-adb-repo/Gold/NB_@{item().gold_table_name}",
									"type": "Expression"
								},
								"baseParameters": {
									"source_system": {
										"value": "@activity('READ_TABLE_DETAILS').output.firstRow.source_system",
										"type": "Expression"
									},
									"table_name": {
										"value": "@activity('READ_TABLE_DETAILS').output.firstRow.bronze_table_name",
										"type": "Expression"
									},
									"landing_timestamp": {
										"value": "@variables('start_time')",
										"type": "Expression"
									},
									"source_file_format": {
										"value": "@coalesce(activity('READ_TABLE_DETAILS').output.firstRow.source_file_format,'')",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_DATABRICKS_WS",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "UPDATE_SUCCESS_",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "SILVER_TO_GOLD",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AZURE_SQL_METADATA",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.audit_log set status='SUCCESS', end_time=SYSUTCDATETIME(),records_written=@{activity('SILVER_TO_GOLD').output.runoutput} where adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{item().table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a17"
			}
		},
		"variables": {
			"test": {
				"type": "Integer"
			}
		},
		"annotations": []
	}
}