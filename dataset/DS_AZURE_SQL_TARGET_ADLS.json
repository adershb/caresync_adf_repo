{
	"name": "DS_AZURE_SQL_TARGET_ADLS",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_SINK",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"schema_name": {
				"type": "string"
			},
			"table_name": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ADF_DEMO"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().table_name,'_',formatDateTime(utcNow(),'yyyy-MM-dd_HH-mm-ss'),'.csv')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().table_name",
					"type": "Expression"
				},
				"fileSystem": "azuresqlingest"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}